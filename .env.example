# Stellar SEP-10 Web Authentication & Network Configuration
# Generate signing keypair with:
# node -e "const {Keypair}=require('@stellar/stellar-sdk');const k=Keypair.random();console.log('PublicKey:',k.publicKey(),'Secret:',k.secret())"
SEP10_SIGNING_SECRET=
STELLAR_AUTH_SECRET=
SEP10_HOME_DOMAIN=safetrust.app
STELLAR_AUTH_HOME_DOMAIN=safetrust.app
SEP10_WEB_AUTH_DOMAIN=safetrust.app
STELLAR_AUTH_WEB_AUTH_DOMAIN=safetrust.app
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Firebase Admin SDK Configuration
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Optional Security Configuration
WALLET_AUTH_ALLOWED_ORIGINS=
